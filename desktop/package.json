{
  "name": "vyapar-saathi-desktop",
  "productName": "Vyapar Saathi",
  "version": "1.0.0",
  "description": "Vyapar Saathi — POS billing, expenses & analytics (desktop app)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "predist": "node copy-ui.mjs",
    "dist": "electron-builder --win",
    "dist:portable": "node copy-ui.mjs && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vyaparsaathi.pos",
    "productName": "Vyapar Saathi",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "../client/public/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vyapar Saathi",
      "artifactName": "Vyapar-Saathi-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Vyapar-Saathi-Portable-${version}.exe"
    }
  }
}
