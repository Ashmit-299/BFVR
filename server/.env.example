[TEMPLATE]
# Port the API listens on (Render/Fly set this automatically)
PORT=5050

# MongoDB Atlas free (M0) connection string — https://www.mongodb.com/atlas
# Network Access must allow 0.0.0.0/0 so cloud hosts can connect.
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/your-db?appName=your-app
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of allowed browser origins ("*" = any).
# The APK/EXE apps are native shells and don't need this — they talk to the
# server directly with a Bearer token, so leave it as "*" unless you also
# serve a website from another domain.
CLIENT_ORIGIN=*

# Set to 0 to skip the automatic demo menu/user seed on boot.
AUTO_SEED=1
