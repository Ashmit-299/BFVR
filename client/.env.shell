# Loaded by `vite build --mode shell` (APK / EXE packaged builds).
#
# The cloud server URL is baked into every packaged app, so there is no
# "enter server address" step on the login screen any more — the same URL
# is used on every device.
VITE_API_BASE=https://vyapar-saathi-4ucf.onrender.com

# Marks the build as a packaged shell (APK / EXE) rather than the web PWA.
VITE_SHELL=1
